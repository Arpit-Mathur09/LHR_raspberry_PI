[Unit]
Description=Robot Flask Backend
After=network.target mediamtx.service
Requires=mediamtx.service

[Service]
Type=simple
User=lhr
WorkingDirectory=/home/lhr/Robot_Client
Environment="PATH=/home/lhr/Robot_Client/env/bin"
ExecStart=/home/lhr/Robot_Client/env/bin/python3 /home/lhr/Robot_Client/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
